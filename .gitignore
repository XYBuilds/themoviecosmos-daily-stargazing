# 环境
.env
.venv/
venv/
__pycache__/
*.pyc

# 数据与索引（大文件不进 git）
data/raw/*
!data/raw/.gitkeep
data/output/*
!data/output/.gitkeep
data/full/*
!data/full/.gitkeep
data/index/*
!data/index/.gitkeep

# 状态
state/*.sqlite
state/*.json
state/*.log
!state/.gitkeep

