          "result-1"
        ],
        "channel_role": "toned"
      },
      "warnings": [
        "how_fragments_expanded_to_contiguous_span"
      ],
      "fit": 0.85
    },
    {
      "id": "p2",
      "text": "Extended generator outages and seasonal demand pressure exposing system vulnerability culminated in a failed power asset going offline, leading to a massive loss of generating capacity. The grid management body and authorities imposing necessary controls responded with an emergency load shedding order, a grid stabilization action to contain the crisis.",
      "source": {
        "agent_id": "The-Ruler",
        "fragments": [
          "why-1",
          "why-2",
          "how-1",
          "how-2",
          "how-3",
          "result-0"
        ],
        "channel_role": "toned"
      },
      "warnings": [
        "how_fragments_expanded_to_contiguous_span"
      ],
      "fit": 0.8
    },
    {
      "id": "p3",
      "text": "Cumulative failures undermining system reliability forced the national power system manager to place the region under strained authority on a red alert. Officials acted as government representatives to prevent a 950 MW capacity shortfall from escalating into a blackout risk increase, exercising emergency load management.",
      "source": {
        "agent_id": "The-Ruler",
