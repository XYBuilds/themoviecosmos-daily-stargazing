  "screenwriter_raw": "{\n  \"pseudos\": [\n    {\n      \"id\": \"p1\",\n      \"text\": \"As the grid operator, we were forced to navigate into new frontiers of stress when a critical power unit failure coincided with multiple plant outages and seasonal heat pushing demand. The crisis navigators in government ordered emergency load shedding to protect the grid, creating a significant power shortfall at the frontier of the system's limits.\",\n      \"fit\": 0.88,\n      \"center\": \"how-2\",\n      \"channel\": \"focalized\",\n      \"focal\": \"who-0\",\n      \"source\": {\n        \"fragments\": [\"why-0\", \"why-1\", \"why-2\", \"how-1\", \"how-2\", \"result-0\"]\n      }\n    },\n    {\n      \"id\": \"p2\",\n      \"text\": \"The Visayas region entered uncharted territory when the grid operator crossed into crisis territory, declaring a red alert. This emergency response was triggered by a unit's journey into failure and the cumulative boundary breaches of other outages, leaving over 950 megawatts of power capacity unavailable in the energy deficit.\",\n      \"fit\": 0.82,\n      \"center\": \"result-0\",\n      \"channel\": \"toned\",\n      \"source\": {\n        \"fragments\": [\"why-0\", \"why-1\", \"how-1\", \"result-0\"]\n      }\n    },\n    {\n      \"id\": \"p3\",\n      \"text\": \"The Philippines grid operator, as the power system operator, made the grid management action of placing the Visayas under red alert. This emergency response followed a critical power unit failure and the heatwave impact of seasonal heat, forcing officials to navigate the emergency by shedding load to avert a larger energy deficit.\",\n      \"fit\": 0.79,\n      \"center\": \"who-0\",\n      \"channel\": \"toned\",\n      \"source\": {\n        \"fragments\": [\"why-0\", \"why-2\", \"how-1\", \"how-2\", \"result-0\"]\n      }\n    }\n  ]\n}",
