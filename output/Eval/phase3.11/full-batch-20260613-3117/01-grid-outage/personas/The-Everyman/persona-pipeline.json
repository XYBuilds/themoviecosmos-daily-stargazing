  "screenwriter_raw": "{\n  \"pseudos\": [\n    {\n      \"id\": \"p1\",\n      \"text\": \"In the Visayas region, the seasonal heat drove demand into a thin operating margin, and when a major power plant failed, it left a power shortage of more than 950 megawatts. The grid was put on high alert, forcing authorities to mandate emergency load shedding to stabilize the system, hitting ordinary households with rolling blackouts.\",\n      \"fit\": 0.85,\n      \"center\": \"result-0\",\n      \"channel\": \"toned\",\n      \"source\": {\n        \"fragments\": [\"why-2\", \"how-0\", \"result-0\", \"how-1\", \"how-2\"]\n      }\n    },\n    {\n      \"id\": \"p2\",\n      \"text\": \"When officials ordered emergency load shedding to prevent a critical transmission line from overloading, it was a control action born from necessity. They were the people in charge trying to manage a crisis that left enough electricity to power hundreds of thousands of homes gone, a burden felt by everyone in the community.\",\n      \"fit\": 0.80,\n      \"center\": \"how-2\",\n      \"channel\": \"toned\",\n      \"source\": {\n        \"fragments\": [\"how-2\", \"result-0\"]\n      }\n    },\n    {\n      \"id\": \"p3\",\n      \"text\": \"A machine everyone depends on, Kepco SPC Power's Unit 2, broke down, becoming a critical equipment failure. This energy infrastructure, a generating unit, was part of a system already strained by ongoing shutdowns at other plants, contributing to a capacity loss that left the area hit by the blackout in a vulnerable state.\",\n      \"fit\": 0.78,\n      \"center\": \"who-1\",\n      \"channel\": \"toned\",\n      \"source\": {\n        \"fragments\": [\"why-0\", \"why-1\", \"result-0\"]\n      }\n    }\n  ]\n}",
