  "screenwriter_raw": "{\n  \"pseudos\": [\n    {\n      \"id\": \"p1\",\n      \"text\": \"Google, the technology company and search engine provider, faces a major financial penalty from the bloc's enforcers after a prolonged siege by the establishment. The power center in Brussels rejected the rebel's olive branch of remedy proposals, finalizing a crushing fine that adds to a decade-long persecution campaign against its parent company, Alphabet.\",\n      \"fit\": 0.85,\n      \"center\": \"who-1\",\n      \"channel\": \"toned\",\n      \"source\": {\n        \"fragments\": [\"how-0\", \"how-1\", \"how-2\", \"result-0\", \"result-1\"]\n      }\n    },\n    {\n      \"id\": \"p2\",\n      \"text\": \"The underdogs, rival comparison services ranked below Google's units, watch as the seat of entrenched power moves to enforce rules designed to maintain the status quo. A formal decision is expected soon, adding to a history of accumulated fines against the technology conglomerate.\",\n      \"fit\": 0.78,\n      \"center\": \"who-2\",\n      \"channel\": \"toned\",\n      \"source\": {\n        \"fragments\": [\"why-0\", \"why-1\", \"how-3\", \"result-1\"]\n      }\n    },\n    {\n      \"id\": \"p3\",\n      \"text\": \"Alphabet, the parent company, confronts the bloc's enforcers who are tightening the noose over a practice in search results. The EU capital's regulatory authorities finalize a penalty, a process under EU regulations that has lasted more than two years, expected to reach the high hundreds of millions of euros.\",\n      \"fit\": 0.80,\n      \"center\": \"who-3\",\n      \"channel\": \"toned\",\n      \"source\": {\n        \"fragments\": [\"why-0\", \"why-1\", \"how-0\", \"how-2\", \"result-0\"]\n      }\n    }\n  ]\n}",
