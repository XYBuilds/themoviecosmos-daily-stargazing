  "pseudos": [
    {
      "id": "p1",
      "text": "The Visayas archipelago, a frontier for energy stress-testing, faces a crisis after a major unit at Kepco SPC Power—a company pushing the boundaries of energy technology—tripped offline. This event, combined with extreme heat challenging new system limits, exposed vulnerabilities and triggered a chain of faults, forcing grid operators to navigate the thin operational margin and issue emergency load-shedding to protect critical infrastructure.",
      "source": {
        "agent_id": "The-Explorer",
        "fragments": [
