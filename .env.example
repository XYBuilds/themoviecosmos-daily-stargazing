# Copy to `.env` and fill in from Bitwarden. `.env` is a gitignored deployment copy,
# not the secrets authority. Never commit or paste live values into issues.

# LLM 主用：MiMo（OpenAI 兼容协议）
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=mimo-v2.5-pro
MIMO_MODEL_PRO=mimo-v2.5-pro

# LLM 备选：DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 选择 MVP 默认走哪个 provider: mimo | deepseek
DEFAULT_LLM_PROVIDER=mimo

# 数据路径（ADR-0001）
CLEANED_CSV=data/output/cleaned.csv
EMBEDDINGS_SOURCE=data/output/text_embeddings.npy
INDEX_DIR=data/index
# TMDB_CSV=data/subsample/TMDB_all_movies_random20.csv  # 仅 subsample plumbing；The Bet 用 CLEANED_CSV

# 简报输出
DAILY_BRIEFING_DIR=output/Daily_Briefing

# 3D 宇宙跳转链接前缀
MOVIE_LINK_PREFIX=https://themoviecosmos.com/movie/

# 本地 Chronicle 仓库根目录（供 publish 星球图片导出；必须含 planet:export script）
MOVIE_COSMOS_GALAXY_ROOT=
# 生产：显式 Chronicle galaxy assets manifest URL（传给 planet:export --manifest-url）
MOVIE_COSMOS_GALAXY_MANIFEST_URL=
# 离线/测试覆盖：本地 galaxy JSON（.json 或 .json.gz）。与 MANIFEST_URL 互斥，不可静默充当生产 active-profile 对等证明
MOVIE_COSMOS_GALAXY_DATA_FILE=

# TMDB API（可选，用于中文译名兜底）
TMDB_API_KEY=

